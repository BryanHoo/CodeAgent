{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "lib": ["ES2024", "DOM"],
    "noEmit": true,
    "paths": {
      "@code-agent/client": ["../packages/client/src/index.ts"],
      "@code-agent/engine-node": ["../packages/engine-node/src/index.ts"],
      "@code-agent/protocol": ["../packages/protocol/src/index.ts"],
      "@code-agent/server": ["../packages/server/src/index.ts"],
      "@code-agent/transport-http": ["../packages/transport-http/src/index.ts"]
    },
    "tsBuildInfoFile": "../.cache/types/tests.tsbuildinfo",
    "types": ["node", "@playwright/test", "@wdio/globals/types", "mocha", "vitest"]
  },
  "include": ["desktop-ipc/**/*.ts", "e2e/**/*.ts", "performance/**/*.ts", "*.test.ts"],
  "references": [
    { "path": "../packages/protocol" },
    { "path": "../packages/engine-node" },
    { "path": "../packages/server" },
    { "path": "../packages/client" },
    { "path": "../packages/transport-http" }
  ]
}
