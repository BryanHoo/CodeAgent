{
  "name": "codeagent",
  "private": true,
  "version": "0.1.3",
  "description": "A local-first desktop client for coding agents",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check": "pnpm version:check && pnpm supply-chain:policy:test && pnpm check:web && pnpm check:rust",
    "check:rust": "pnpm rust:fmt:check && pnpm rust:clippy && pnpm rust:test && pnpm performance:rust",
    "check:web": "pnpm lint && pnpm typecheck && pnpm test:run && pnpm tauri:constraints:test && pnpm performance:budget:test && pnpm build && pnpm performance:budget",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix .",
    "performance:budget": "node scripts/performance-budget.mjs",
    "performance:budget:test": "node --test scripts/performance-budget.test.mjs",
    "performance:browser": "playwright test --config benchmarks/playwright.config.ts",
    "performance:rust": "cargo test --manifest-path src-tauri/Cargo.toml performance_baseline --locked -- --ignored --nocapture",
    "performance:webview": "cross-env CODEAGENT_WEBVIEW_PERFORMANCE_TEST=1 CODEAGENT_WEBVIEW_RELEASE=1 wdio run wdio.conf.ts",
    "performance:webview:build": "cross-env VITE_WEBVIEW_TEST=1 node scripts/run-tauri.mjs build --features webview-tests --no-bundle --no-sign --ci --config src-tauri/tauri.webview-test.conf.json",
    "preview": "vite preview",
    "rust:check": "cargo check --manifest-path src-tauri/Cargo.toml --locked",
    "rust:clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --all-features --locked -- -D warnings",
    "rust:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "rust:fmt:check": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "rust:test": "cargo test --manifest-path src-tauri/Cargo.toml --all-features --locked",
    "supply-chain:policy:test": "node --test scripts/supply-chain-policy.test.mjs",
    "test": "vitest",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:run": "vitest run",
    "test:webview": "wdio run wdio.conf.ts",
    "test:webview:build": "cross-env VITE_WEBVIEW_TEST=1 node scripts/run-tauri.mjs build --debug --features webview-tests --no-bundle --no-sign --ci --config src-tauri/tauri.webview-test.conf.json",
    "test:webview:real": "cross-env CODEAGENT_REAL_RUNTIME_TEST=1 wdio run wdio.conf.ts",
    "tauri:constraints:test": "node --test scripts/app-icon.test.mjs scripts/changelog.test.mjs scripts/run-tauri.test.mjs scripts/webview-bridge-readiness.test.mjs scripts/windows-subsystem.test.mjs",
    "typecheck": "tsc -b",
    "version:check": "node scripts/check-version.mjs",
    "tauri": "node scripts/run-tauri.mjs"
  },
  "dependencies": {
    "@headless-tree/core": "^1.7.0",
    "@headless-tree/react": "^1.7.0",
    "@pierre/diffs": "1.2.12",
    "@sinclair/typebox": "^0.34.52",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-router": "1.170.18",
    "@tanstack/react-virtual": "3.14.9",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "anser": "^2.3.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "26.3.6",
    "lucide-react": "1.25.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "17.0.11",
    "shiki": "^4.4.3",
    "sonner": "2.0.7",
    "streamdown": "2.5.0",
    "tailwind-merge": "^3.6.0",
    "uuid": "14.0.1",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/eslint-plugin-query": "^5.102.8",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/browser-playwright": "4.1.11",
    "@wdio/cli": "9.31.5",
    "@wdio/globals": "9.31.3",
    "@wdio/local-runner": "9.31.5",
    "@wdio/mocha-framework": "9.31.5",
    "@wdio/spec-reporter": "9.31.2",
    "@wdio/tauri-plugin": "1.3.0",
    "@wdio/tauri-service": "1.3.0",
    "cross-env": "10.0.0",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vitest-browser-react": "2.2.0"
  }
}
