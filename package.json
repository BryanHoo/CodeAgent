{
  "name": "codeagent",
  "private": true,
  "version": "0.1.0",
  "description": "A local-first desktop client for coding agents",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check": "pnpm version:check && pnpm check:web && pnpm check:rust",
    "check:rust": "pnpm rust:fmt:check && pnpm rust:clippy && pnpm rust:test",
    "check:web": "pnpm lint && pnpm typecheck && pnpm test:run && pnpm build",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "preview": "vite preview",
    "rust:check": "cargo check --manifest-path src-tauri/Cargo.toml --locked",
    "rust:clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --all-features --locked -- -D warnings",
    "rust:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "rust:fmt:check": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "rust:test": "cargo test --manifest-path src-tauri/Cargo.toml --all-features --locked",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc -b",
    "version:check": "node scripts/check-version.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@headless-tree/core": "^1.7.0",
    "@headless-tree/react": "^1.7.0",
    "@pierre/diffs": "1.3.6",
    "@sinclair/typebox": "^0.34.52",
    "@tanstack/react-query": "5.102.2",
    "@tanstack/react-router": "1.170.32",
    "@tanstack/react-virtual": "3.14.10",
    "@tauri-apps/api": "^2.11.1",
    "anser": "^2.3.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "26.4.0",
    "lucide-react": "1.34.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "17.0.12",
    "react-virtuoso": "^4.18.12",
    "shadcn": "^4.19.0",
    "shiki": "^4.4.3",
    "sonner": "2.0.8",
    "streamdown": "2.5.0",
    "tailwind-merge": "^3.6.0",
    "use-sync-external-store": "^1.6.0",
    "uuid": "14.0.2",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/use-sync-external-store": "^1.5.0",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
