{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "withGlobalTauri": true,
    "security": {
      "capabilities": [
        "default",
        "desktop-pet",
        {
          "identifier": "webview-tests",
          "description": "Test-only WebdriverIO access for native WebView tests",
          "windows": ["main", "desktop-pet"],
          "permissions": ["wdio:default", "wdio-webdriver:default"]
        }
      ]
    }
  }
}
