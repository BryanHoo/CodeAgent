  "devDependencies": {
    "@code-agent/engine-node": "workspace:*",
    "@code-agent/protocol": "workspace:*",
    "@code-agent/server": "workspace:*",
    "tsup": "catalog:"
  },
  "optionalDependencies": {
    "@bryanhu/code-agent-darwin-arm64": "1.10.0",
    "@bryanhu/code-agent-linux-x64-gnu": "1.10.0",
    "@bryanhu/code-agent-win32-x64-msvc": "1.10.0"
  },
  "license": "MIT"
}
