{
  "name": "@bryanhu/code-agent",
  "version": "1.10.0",
  "private": false,
  "description": "通过 Web 操作本地 Coding Agent 的应用",
  "type": "module",
  "author": "BryanHu",
  "homepage": "https://github.com/BryanHoo/CodeAgent#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BryanHoo/CodeAgent.git"
  },
  "bugs": {
    "url": "https://github.com/BryanHoo/CodeAgent/issues"
  },
  "keywords": [
    "ai",
    "codex",
    "coding-agent",
    "developer-tools",
    "web"
  ],
  "engines": {
    "node": ">=24"
  },
  "bin": {
